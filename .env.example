DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE>?schema=public
SESSION_SECRET=<REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS>
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# Razorpay test credentials only. Never use live credentials in this setup.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Configure all SMTP values to enable verification and password-reset email delivery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<SMTP_USERNAME>
# SMTP_PASSWORD=<SMTP_PASSWORD>
# SMTP_FROM=CampusConnect <no-reply@example.com>
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_TWILIO_CONTENT_SID=
WHATSAPP_REMINDER_OFFSETS_HOURS=24,1
# Optional native browser push. Generate VAPID keys and a 32-byte encryption key
# as documented in docs/notifications-setup.md. Never expose the private key.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
