# Required for the local API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusconnect?schema=public
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Local application defaults
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Razorpay Test Mode only. Leave blank to disable paid checkout.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional email delivery. Configure all SMTP values together.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional WhatsApp reminders; disabled by default.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_TWILIO_CONTENT_SID=
WHATSAPP_REMINDER_OFFSETS_HOURS=24,1

# Optional browser push. Configure the full set together.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
